ARG NEXT_PUBLIC_BASE_PATH=/supabase

FROM node:22-slim AS clone

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone \
    --filter=blob:none \
    --sparse \
    --depth=1 \
    https://github.com/supabase/supabase.git . && \
    git sparse-checkout set apps/studio packages patches

FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        git python3 ca-certificates build-essential && \
    rm -rf /var/lib/apt/lists/* && \
    update-ca-certificates

RUN npm install -g pnpm@10.24.0

WORKDIR /app
COPY --from=clone /src .

FROM base AS turbo
RUN pnpm dlx turbo@2.9.14 prune studio --docker

FROM base AS deps
COPY --from=turbo /app/out/json ./
COPY --from=turbo /app/out/pnpm-lock.yaml ./
COPY --from=clone /src/patches/ ./patches/
RUN pnpm install --no-frozen-lockfile

FROM deps AS builder
ARG NEXT_PUBLIC_BASE_PATH
COPY --from=turbo /app/out/full ./
ENV NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH}
RUN pnpm --filter studio exec next build

FROM node:22-slim AS production
WORKDIR /app

COPY --from=builder /app/apps/studio/public          ./apps/studio/public
COPY --from=builder /app/apps/studio/.next/standalone ./
COPY --from=builder /app/apps/studio/.next/static     ./apps/studio/.next/static

EXPOSE 3000
HEALTHCHECK --interval=5s --timeout=5s --retries=3 \
    CMD node -e "fetch('http://localhost:3000/api/platform/profile').then((r)=>{if(r.status>=500)throw new Error(r.status)})"
CMD ["node", "apps/studio/server.js"]
