{
    acme_ca https://acme.zerossl.com/v2/DV90
    email {$ACME_EMAIL}
}

(ip_vpn) {
    remote_ip 10.8.0.0/24 172.28.0.0/16
}

(compression) {
    encode zstd gzip
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "{args[0]}"
        -Server
    }
}

{$APP_DOMAIN} {
    import security_headers DENY
    import compression
    @public_assets {
        path /assets/*
    }
    handle @public_assets {
        root * /srv/public-assets
        uri strip_prefix /assets
        file_server
    }
    @short_links {
        path /l/*
    }
    handle @short_links {
        uri strip_prefix /l
        rewrite * /functions/v1/hosting/link{uri}
        reverse_proxy kong:8000 {
            header_up X-Real-IP {remote_host}
        }
    }
    @browser {
        header Accept *text/html*
        not path /functions/v1/hosting/*
        not path /storage/v1/object/public/*
    }
    handle @browser {
        redir {$MAIN_DOMAIN} 301
    }
    @app_api {
        path /v1/app/* /realtime/v1/* /functions/v1/hosting/* /storage/v1/object/public/*
    }
    handle @app_api {
        header -WWW-Authenticate
        reverse_proxy kong:8000 {
            header_up X-Real-IP {remote_host}
        }
    }
    handle {
        respond 403
    }
}

{$ADMIN_DOMAIN} {
    log {
        output stderr
        format json
        level DEBUG
    }
    import security_headers DENY
    import compression
    @browser {
        header Accept *text/html*
        not path /functions/v1/hosting/*
    }
    handle @browser {
        redir {$MAIN_DOMAIN} 301
    }
    @admin_api {
        import ip_vpn
        path /v1/admin/* /realtime/v1/* /storage/v1/* /functions/v1/hosting/*
    }
    handle @admin_api {
        reverse_proxy kong:8000 {
            header_up X-Real-IP {remote_host}
        }
    }
    handle {
        respond 403
    }
}

{$INTRA_DOMAIN} {
    log {
        output stderr
        format json
        level DEBUG
    }
    import security_headers SAMEORIGIN
    import compression

    handle / {
        redir {$MAIN_DOMAIN} permanent
    }

    @vpn_only {
        import ip_vpn
        path \
            /developers/docs \
            /developers/docs/* \
            /logo-dark.png \
            /logo-light.png
    }
    handle @vpn_only {
        handle /developers/docs {
            redir * /developers/docs/ 301
        }
        handle /developers/docs/admin* {
            forward_auth http://api:3000 {
                uri /auth/intra
                header_up X-Real-IP {remote_host}
                header_up X-Required-Permission developers:docs:admin
            }
            uri strip_prefix /developers/docs/admin
            root * /srv/docs/admin
            try_files {path} /index.html
            file_server
        }
        handle /developers/docs/app* {
            forward_auth http://api:3000 {
                uri /auth/intra
                header_up X-Real-IP {remote_host}
                header_up X-Required-Permission developers:docs:app
            }
            uri strip_prefix /developers/docs/app
            root * /srv/docs/app
            try_files {path} /index.html
            file_server
        }
        handle /developers/docs/* {
            forward_auth http://api:3000 {
                uri /auth/intra
                header_up X-Real-IP {remote_host}
                header_up X-Required-Permission developers:docs
            }
            uri strip_prefix /developers/docs
            root * /srv/docs/landing
            try_files {path} /index.html
            file_server
        }
        handle /logo-dark.png {
            root * /srv/docs/admin
            file_server
        }
        handle /logo-light.png {
            root * /srv/docs/admin
            file_server
        }
    }

    @vpn_intra_vpn {
        import ip_vpn
        path /vpn*
    }
    handle @vpn_intra_vpn {
        forward_auth http://api:3000 {
            uri /auth/intra
            header_up X-Real-IP {remote_host}
            header_up X-Required-Permission vpn
        }
        uri strip_prefix /vpn
        reverse_proxy host.docker.internal:51821
    }

    @vpn_supabase_cloud_stubs {
        import ip_vpn
        path \
            /supabase/api/platform/notifications \
            /supabase/api/platform/cli-release-version \
            /supabase/api/platform/get-deployment-commit \
            /supabase/api/platform/enabled-features-overrides \
            /api/platform/notifications \
            /api/platform/cli-release-version \
            /api/platform/get-deployment-commit \
            /api/platform/enabled-features-overrides
    }
    handle @vpn_supabase_cloud_stubs {
        header Content-Type "application/json"
        respond `[]` 200
    }

    @vpn_supabase_bare_api {
        import ip_vpn
        path /api/platform/*
    }
    handle @vpn_supabase_bare_api {
        forward_auth http://api:3000 {
            uri /auth/intra
            header_up X-Real-IP {remote_host}
            header_up X-Required-Permission supabase
        }
        rewrite * /supabase{uri}
        reverse_proxy studio:3000
    }

    @vpn_supabase_assets {
        import ip_vpn
        path \
            /supabase/_next/* \
            /supabase/favicon* \
            /supabase/img/* \
            /supabase/icons/* \
            /supabase/monaco-editor/* \
            /supabase/api/* \
            /_next/* /img/* /icons/* /favicon.ico /favicon/*  /monaco-editor/*
    }
    handle @vpn_supabase_assets {
        forward_auth http://api:3000 {
            uri /auth/intra
            header_up X-Real-IP {remote_host}
            header_up X-Required-Permission supabase
        }
        reverse_proxy studio:3000
    }

    @vpn_intra_supabase {
        import ip_vpn
        path /supabase* /project/*
    }
    handle @vpn_intra_supabase {
        forward_auth http://api:3000 {
            uri /auth/intra
            header_up X-Real-IP {remote_host}
            header_up X-Required-Permission supabase
        }
        reverse_proxy studio:3000
    }

    @vpn_catchall {
        import ip_vpn
        not path /developers*
    }
    handle @vpn_catchall {
        forward_auth http://api:3000 {
            uri /auth/intra
            header_up X-Real-IP {remote_host}
            header_up X-Required-Permission vpn
        }
        reverse_proxy host.docker.internal:51821
    }

    @has_parent {
        path_regexp parent ^(/.+)/[^/]+$
    }
    handle @has_parent {
        redir * {http.regexp.parent.1} 302
    }

    handle {
        redir * / 302
    }
}
