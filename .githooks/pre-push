set -uo pipefail

failed=0
started=$SECONDS

step() {
  local label="$1"
  shift

  if ! "$@" >/tmp/scribe-prepush.log 2>&1; then
    echo "FAILED   $label"
    sed 's/^/         /' /tmp/scribe-prepush.log | tail -25
    failed=$((failed + 1))
    return
  fi

  echo "ok       $label"
}

missing() {
  echo "skipped  $1 ($2 is not installed)"
}

if command -v deno >/dev/null 2>&1; then
  step "host lints"        bash -c 'cd host && deno lint'
  step "host type-checks"  bash -c 'cd host && deno task check'
  step "sdk/js type-checks" bash -c 'cd sdk/js && deno task check'
else
  missing "the Deno checks" deno
fi

if command -v protoc >/dev/null 2>&1; then
  step "the contract compiles" bash -c '
    cd "$(dirname "$PWD")"
    root="$(basename "$OLDPWD")"
    find "$root" -name "*.proto" -path "*/protocol/*" -print0 | xargs -0 protoc -I . --descriptor_set_out=/dev/null'
else
  missing "the protocol check" protoc
fi

step "every source file carries the license header" bash .github/headers/check.sh

rm -f /tmp/scribe-prepush.log

if [ "$failed" -gt 0 ]; then
  cat >&2 <<MESSAGE

Push refused: $failed check(s) failed after $((SECONDS - started))s.

These are the same checks CI runs, so pushing would only move the failure to a
place where it blocks the release instead of your terminal.

If you know what you are doing, git push --no-verify skips this hook. CI will
still catch it, and main will still refuse the merge.
MESSAGE
  exit 1
fi

echo "All checks passed in $((SECONDS - started))s"
