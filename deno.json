{
  "version": "1.0.0",
  "workspace": [
    "./alchemy",
    "./engine/contracts",
    "./engine/runtime",
    "./engine/kernel",
    "./engine/embedder",
    "./engine/testing",
    "./engine/shell",
    "./tests",
    "./sdk/js"
  ],
  "exclude": [
    "packages/*/tests/e2e/fixtures",
    "packages/*/tests/e2e/.e2e"
  ],
  "tasks": {
    "check": "deno check engine packages",
    "test": "deno test --allow-env --allow-sys --allow-read --allow-write --env-file=tests/.env.test --parallel engine packages tests",
    "test:net": "deno test --allow-env --allow-sys --allow-read --allow-write --allow-net --env-file=tests/.env.test --parallel engine packages tests",
    "lint": "deno lint"
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "sdk/js/gen",
      "packages/*/deploy/services",
      "packages/*/deploy/recipes",
      "packages/*/tests/e2e",
      "packages/*/fixtures"
    ]
  },
  "lint": {
    "plugins": [
      "./.lint/private-module-scope.ts",
      "./.lint/member-escape.ts",
      "./.lint/sealed-runtime.ts"
    ],
    "rules": {
      "include": [
        "private-module-scope/private-module-scope",
        "member-escape/member-escape",
        "sealed-runtime/sealed-runtime"
      ]
    },
    "exclude": [
      "sdk/js/gen",
      "sdk/js/example",
      "packages/auth/tests/tests/pending_token.test.ts",
      "packages/foundation/tests/tests/cron/runner.test.ts",
      "packages/foundation/tests/tests/cron/hardening_runner.test.ts",
      "packages/storage/tests/tests/video_frame.test.ts"
    ]
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react@^19"
  },
  "imports": {
