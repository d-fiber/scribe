{
  "version": "1.0.0",
  "workspace": [
    "./engine/alchemy",
    "./engine/contracts",
    "./engine/runtime",
    "./engine/kernel",
    "./engine/embedder",
    "./engine/testing",
    "./engine/shell",
    "./engine/tests",
    "./packages/audience",
    "./packages/auth",
    "./packages/dynamic_links",
    "./packages/foundation",
    "./packages/realtime",
    "./packages/remote_configs",
    "./packages/search",
    "./packages/storage",
    "./sdk/js"
  ],
  "tasks": {
    "check": "deno check engine packages",
    "test": "deno test --allow-env --allow-sys --allow-read --allow-write --env-file=engine/tests/.env.test --parallel engine packages",
    "test:net": "deno test --allow-env --allow-sys --allow-read --allow-write --allow-net --env-file=engine/tests/.env.test --parallel engine packages",
    "lint": "deno lint"
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "templates",
      "sdk/js/gen"
    ]
  },
  "lint": {
    "plugins": [
      "./engine/.lint/private-module-scope.ts",
      "./engine/.lint/member-escape.ts"
    ],
    "rules": {
      "include": [
        "private-module-scope/private-module-scope",
        "member-escape/member-escape"
      ]
    },
    "exclude": [
      "sdk/js/gen",
      "sdk/js/example"
    ]
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react@^19"
  },
  "imports": {
    "@bufbuild/protobuf": "npm:@bufbuild/protobuf@2.14.0",
    "@bufbuild/protobuf/codegenv2": "npm:@bufbuild/protobuf@2.14.0/codegenv2",
    "@bufbuild/protobuf/wkt": "npm:@bufbuild/protobuf@2.14.0/wkt",
    "@jsquash/webp/decode": "npm:@jsquash/webp@1.5.0/decode.js",
    "@jsquash/webp/encode": "npm:@jsquash/webp@1.5.0/encode.js",
    "@nats-io/jetstream": "jsr:@nats-io/jetstream@3.4.0",
    "@nats-io/transport-deno": "jsr:@nats-io/transport-deno@3.4.0",
    "@opensearch-project/opensearch": "npm:@opensearch-project/opensearch@2.13.0",
    "@opensearch-project/opensearch/": "npm:/@opensearch-project/opensearch@2.13.0/",
    "@react-email/components": "npm:@react-email/components@0.5.7",
    "@scribe/alchemy": "./engine/alchemy/mod.ts",
    "@scribe/alchemy/": "./engine/alchemy/",
    "@scribe/alchemy/body": "./engine/alchemy/api/body/mod.ts",
    "@scribe/alchemy/http": "./engine/alchemy/http/mod.ts",
    "@scribe/alchemy/observe": "./engine/alchemy/observe/mod.ts",
    "@scribe/alchemy/route": "./engine/alchemy/api/route/mod.ts",
    "@scribe/alchemy/server": "./engine/alchemy/api/server/mod.ts",
    "@scribe/alchemy/test": "./engine/alchemy/test/mod.ts",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/media-types": "jsr:@std/media-types@1.1.0",
    "@std/testing/mock": "jsr:@std/testing@1.0.20/mock",
    "@std/testing/time": "jsr:@std/testing@1.0.20/time",
    "@supabase/postgrest-js": "npm:@supabase/postgrest-js@1.21.4",
    "blurhash": "npm:blurhash@2.0.5",
    "croner": "npm:croner@8.1.2",
    "fast-png": "npm:fast-png@6.4.0",
    "hono": "jsr:@hono/hono@4.13.4",
    "ioredis": "npm:ioredis@5.11.1",
    "jose": "jsr:@panva/jose@6.2.10",
    "jpeg-js": "npm:jpeg-js@0.4.4",
    "libphonenumber-js": "npm:libphonenumber-js@1.13.9",
    "lucide-react": "npm:lucide-react@1.24.0",
    "lucide-react/bundle": "npm:/lucide-react@1.24.0/dist/cjs/lucide-react.js",
    "react": "npm:react@19.2.8",
    "react-dom/server": "npm:react-dom@19.2.7/server",
    "react/jsx-runtime": "npm:react@19.2.8/jsx-runtime"
  }
}
