{
  "version": "1.0.0",
  "exclude": [
    "packages/*/tests/e2e/fixtures",
    "packages/*/tests/e2e/.e2e"
  ],
  "targets": {
    "check": {
      "dirs": ["engine", "packages"]
    },
    "check:examples": {
      "dirs": ["engine", "alchemy", "packages"],
      "docsOnly": true
    },
    "test": {
      "dirs": ["engine", "packages", "tests"],
      "envFile": "tests/.env.test",
      "network": "loopback"
    },
    "test:net": {
      "dirs": ["engine", "packages", "tests"],
      "envFile": "tests/.env.test",
      "network": "full"
    },
    "lint:custom": {
      "script": ".lint/run.ts"
    },
    "lint:builtin": {}
  },
  "tools": {
    "gen:workspace": "bash dev_tools/gen/workspace.sh"
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "sdk/js/gen",
      "packages/*/deploy/services",
      "packages/*/deploy/recipes",
      "packages/*/tests/e2e",
      "packages/*/fixtures"
    ]
  },
  "lint": {
    "exclude": [
      "sdk/js/gen",
      "sdk/js/example"
    ]
  },
  "imports": {
    "@aws-sdk/client-sqs": "npm:@aws-sdk/client-sqs@3.1125.0",
