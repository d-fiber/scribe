{
  "version": "1.0.0",
  "exclude": [
    "packages/*/tests/e2e/fixtures",
    "packages/*/tests/e2e/.e2e"
  ],
  "tasks": {
    "check": "deno check engine packages",
    "check:examples": "deno test --doc --no-run engine alchemy packages",
    "test": "deno test --allow-env --allow-sys --allow-read --allow-write --allow-run --allow-net=127.0.0.1 --env-file=tests/.env.test --parallel engine packages tests",
    "test:net": "deno test --allow-env --allow-sys --allow-read --allow-write --allow-run --allow-net --env-file=tests/.env.test --parallel engine packages tests",
    "lint": "deno lint && deno run --allow-read --allow-env .lint/run.ts",
    "gen:workspace": "bash dev_tools/gen/workspace.sh"
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "sdk/js/gen",
      "packages/*/deploy/services",
      "packages/*/deploy/recipes",
      "packages/*/tests/e2e",
      "packages/*/fixtures"
    ]
  },
  "lint": {
    "exclude": [
      "sdk/js/gen",
      "sdk/js/example"
    ]
  },
  "imports": {
    "@bufbuild/protobuf": "npm:@bufbuild/protobuf@2.14.0",
    "@bufbuild/protobuf/codegenv2": "npm:@bufbuild/protobuf@2.14.0/codegenv2",
    "@bufbuild/protobuf/wkt": "npm:@bufbuild/protobuf@2.14.0/wkt",
    "@jsquash/webp/decode": "npm:@jsquash/webp@1.5.0/decode.js",
    "@jsquash/webp/encode": "npm:@jsquash/webp@1.5.0/encode.js",
    "@nats-io/jetstream": "jsr:@nats-io/jetstream@3.4.0",
    "@nats-io/transport-deno": "jsr:@nats-io/transport-deno@3.4.0",
    "@nats-io/transport-node": "npm:@nats-io/transport-node@3.4.0",
    "@opensearch-project/opensearch": "npm:@opensearch-project/opensearch@2.13.0",
    "@opensearch-project/opensearch/": "npm:/@opensearch-project/opensearch@2.13.0/",
    "@scribe/alchemy": "./alchemy/mod.ts",
    "@scribe/alchemy/body": "./alchemy/api/body/mod.ts",
    "@scribe/alchemy/http": "./alchemy/http/mod.ts",
    "@scribe/alchemy/observe": "./alchemy/observe/mod.ts",
    "@scribe/alchemy/route": "./alchemy/api/route/mod.ts",
    "@scribe/alchemy/server": "./alchemy/api/server/mod.ts",
