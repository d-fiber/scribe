{
  "workspace": [
    "./core",
    "./dependencies",
    "./alchemy",
    "./pkg/builder",
    "./pkg/packages/audience",
    "./pkg/packages/auth",
    "./pkg/packages/dynamic_links",
    "./pkg/packages/foundation",
    "./pkg/packages/realtime",
    "./pkg/packages/remote_configs",
    "./pkg/packages/search",
    "./pkg/packages/storage"
  ],
  "tasks": {
    "check": "deno check **/*.ts",
    "test": "deno test --allow-env --allow-sys --allow-read --env-file=tests/.env.test --ignore=pkg/builder/tests",
    "test:net": "deno test --allow-env --allow-sys --allow-read --allow-net --env-file=tests/.env.test --ignore=pkg/builder/tests",
    "test:pkg": "deno test --allow-read --allow-write pkg/builder/tests",
    "e2e:render": "deno run --allow-read --allow-write pkg/packages/foundation/e2e_tests/render.ts",
    "e2e:compose": "docker compose --project-directory pkg/packages/foundation/e2e_tests --env-file pkg/packages/foundation/e2e_tests/e2e.env -f pkg/packages/foundation/e2e_tests/.generated/valkery.yaml -f pkg/packages/foundation/e2e_tests/.generated/queue.yaml -f pkg/packages/foundation/e2e_tests/.generated/database.yaml -f pkg/packages/foundation/e2e_tests/compose.override.yaml",
    "e2e:up": "deno task e2e:render && deno task e2e:compose up -d --build --wait",
    "e2e:down": "deno task e2e:compose down -v",
    "e2e:reset": "deno task e2e:compose down -v && rm -rf pkg/packages/foundation/e2e_tests/.postgres",
    "test:e2e": "deno test --allow-env --allow-sys --allow-read --allow-net --env-file=tests/.env.test pkg/packages/foundation/e2e_tests/valkery.e2e.ts pkg/packages/foundation/e2e_tests/database.e2e.ts pkg/packages/foundation/e2e_tests/queue.e2e.ts pkg/packages/foundation/e2e_tests/cron.e2e.ts pkg/packages/foundation/e2e_tests/hook.e2e.ts pkg/packages/foundation/e2e_tests/http.e2e.ts pkg/packages/foundation/e2e_tests/isolate.e2e.ts pkg/packages/foundation/e2e_tests/rate_limit.e2e.ts pkg/packages/foundation/e2e_tests/trigger.e2e.ts",
    "realtime:e2e:render": "deno run --allow-read --allow-write pkg/packages/realtime/e2e_tests/render.ts",
    "realtime:e2e:compose": "docker compose --profile realtime --project-directory pkg/packages/realtime/e2e_tests --env-file pkg/packages/realtime/e2e_tests/e2e.env -f pkg/packages/realtime/e2e_tests/.generated/database.yaml -f pkg/packages/realtime/e2e_tests/.generated/realtime.yaml -f pkg/packages/realtime/e2e_tests/compose.override.yaml",
    "realtime:e2e:up": "deno task realtime:e2e:render && deno task realtime:e2e:compose up -d --build --wait",
    "realtime:e2e:down": "deno task realtime:e2e:compose down -v",
    "realtime:e2e:reset": "deno task realtime:e2e:compose down -v && rm -rf pkg/packages/realtime/e2e_tests/.postgres",
    "storage:e2e:render": "deno run --allow-read --allow-write pkg/packages/storage/e2e_tests/render.ts",
    "storage:e2e:compose": "docker compose --project-directory pkg/packages/storage/e2e_tests --env-file pkg/packages/storage/e2e_tests/e2e.env -f pkg/packages/storage/e2e_tests/.generated/database.yaml -f pkg/packages/storage/e2e_tests/.generated/storage.yaml -f pkg/packages/storage/e2e_tests/compose.override.yaml",
    "storage:e2e:up": "deno task storage:e2e:render && deno task storage:e2e:compose up -d --build --wait",
    "storage:e2e:down": "deno task storage:e2e:compose down -v",
    "storage:e2e:reset": "deno task storage:e2e:compose down -v && rm -rf pkg/packages/storage/e2e_tests/.postgres",
    "test:e2e:storage": "deno test --allow-env --allow-sys --allow-read --allow-net --env-file=tests/.env.test pkg/packages/storage/e2e_tests/objects.e2e.ts pkg/packages/storage/e2e_tests/visibility.e2e.ts",
    "test:e2e:realtime": "deno test --allow-env --allow-sys --allow-read --allow-net --env-file=tests/.env.test pkg/packages/realtime/e2e_tests/listening.e2e.ts pkg/packages/realtime/e2e_tests/payload.e2e.ts",
    "search:e2e:render": "deno run --allow-read --allow-write pkg/packages/search/e2e_tests/render.ts",
    "search:e2e:compose": "docker compose --profile search --project-directory pkg/packages/search/e2e_tests --env-file pkg/packages/search/e2e_tests/e2e.env -f pkg/packages/search/e2e_tests/.generated/valkery.yaml -f pkg/packages/search/e2e_tests/.generated/database.yaml -f pkg/packages/search/e2e_tests/.generated/search.yaml -f pkg/packages/search/e2e_tests/.generated/search_overlay.yaml -f pkg/packages/search/e2e_tests/compose.override.yaml",
    "search:e2e:up": "deno task search:e2e:render && deno task search:e2e:compose up -d --build --wait",
    "search:e2e:down": "deno task search:e2e:compose down -v",
    "search:e2e:reset": "deno task search:e2e:compose down -v && rm -rf pkg/packages/search/e2e_tests/.postgres",
    "test:e2e:search": "deno test --allow-env --allow-sys --allow-read --allow-net --env-file=tests/.env.test pkg/packages/search/e2e_tests/indexing.e2e.ts pkg/packages/search/e2e_tests/backlog.e2e.ts",
    "dynamic_links:e2e:render": "deno run --allow-read --allow-write pkg/packages/dynamic_links/e2e_tests/render.ts",
    "dynamic_links:e2e:compose": "docker compose --project-directory pkg/packages/dynamic_links/e2e_tests --env-file pkg/packages/dynamic_links/e2e_tests/e2e.env -f pkg/packages/dynamic_links/e2e_tests/.generated/valkery.yaml -f pkg/packages/dynamic_links/e2e_tests/.generated/queue.yaml -f pkg/packages/dynamic_links/e2e_tests/.generated/database.yaml -f pkg/packages/dynamic_links/e2e_tests/.generated/dynamic_links_overlay.yaml -f pkg/packages/dynamic_links/e2e_tests/compose.override.yaml",
    "dynamic_links:e2e:up": "deno task dynamic_links:e2e:render && deno task dynamic_links:e2e:compose up -d --build --wait",
    "dynamic_links:e2e:down": "deno task dynamic_links:e2e:compose down -v",
    "dynamic_links:e2e:reset": "deno task dynamic_links:e2e:compose down -v && rm -rf pkg/packages/dynamic_links/e2e_tests/.postgres",
    "test:e2e:dynamic_links": "deno test --allow-env --allow-sys --allow-read --allow-net --env-file=tests/.env.test pkg/packages/dynamic_links/e2e_tests/links.e2e.ts pkg/packages/dynamic_links/e2e_tests/statistics.e2e.ts",
    "audience:e2e:render": "deno run --allow-read --allow-write pkg/packages/audience/e2e_tests/render.ts",
    "audience:e2e:compose": "docker compose --project-directory pkg/packages/audience/e2e_tests --env-file pkg/packages/audience/e2e_tests/e2e.env -f pkg/packages/audience/e2e_tests/.generated/valkery.yaml -f pkg/packages/audience/e2e_tests/.generated/database.yaml -f pkg/packages/audience/e2e_tests/.generated/audience_overlay.yaml -f pkg/packages/audience/e2e_tests/compose.override.yaml",
    "audience:e2e:up": "deno task audience:e2e:render && deno task audience:e2e:compose up -d --build --wait",
    "audience:e2e:down": "deno task audience:e2e:compose down -v",
    "audience:e2e:reset": "deno task audience:e2e:compose down -v && rm -rf pkg/packages/audience/e2e_tests/.postgres",
    "test:e2e:audience": "deno test --allow-env --allow-sys --allow-read --allow-net --env-file=tests/.env.test pkg/packages/audience/e2e_tests/membership.e2e.ts pkg/packages/audience/e2e_tests/expiry.e2e.ts pkg/packages/audience/e2e_tests/cache.e2e.ts pkg/packages/audience/e2e_tests/hardening.e2e.ts",
    "remote_configs:e2e:render": "deno run --allow-read --allow-write pkg/packages/remote_configs/e2e_tests/render.ts",
    "remote_configs:e2e:compose": "docker compose --project-directory pkg/packages/remote_configs/e2e_tests --env-file pkg/packages/remote_configs/e2e_tests/e2e.env -f pkg/packages/remote_configs/e2e_tests/.generated/valkery.yaml -f pkg/packages/remote_configs/e2e_tests/.generated/database.yaml -f pkg/packages/remote_configs/e2e_tests/.generated/remote_configs_overlay.yaml -f pkg/packages/remote_configs/e2e_tests/compose.override.yaml",
    "remote_configs:e2e:up": "deno task remote_configs:e2e:render && deno task remote_configs:e2e:compose up -d --build --wait",
    "remote_configs:e2e:down": "deno task remote_configs:e2e:compose down -v",
    "remote_configs:e2e:reset": "deno task remote_configs:e2e:compose down -v && rm -rf pkg/packages/remote_configs/e2e_tests/.postgres",
    "test:e2e:remote_configs": "deno test --allow-env --allow-sys --allow-read --allow-net --env-file=tests/.env.test pkg/packages/remote_configs/e2e_tests/values.e2e.ts pkg/packages/remote_configs/e2e_tests/expiry.e2e.ts pkg/packages/remote_configs/e2e_tests/cache.e2e.ts pkg/packages/remote_configs/e2e_tests/hardening.e2e.ts",
    "preview:hosting": "deno run --config deno.json --allow-net --allow-env --allow-read --env-file=tests/.env.test --watch api/internal/hosting/_preview.ts",
    "docs:install": "cd api/public/docs && npm install",
    "docs": "cd api/public/docs && npm run dev"
  },
  "fmt": {
    "lineWidth": 120
  },
  "lint": {
    "plugins": [
      "./core/.lint/private-module-scope.ts",
      "./core/.lint/layers.ts",
      "./core/.lint/project-boundary.ts"
    ],
    "rules": {
      "include": [
        "private-module-scope/private-module-scope",
        "layers/layers",
        "project-boundary/project-boundary"
      ]
    }
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "imports": {
    "@bufbuild/protobuf": "npm:@bufbuild/protobuf@^2",
    "@bufbuild/protobuf/codegenv2": "npm:@bufbuild/protobuf@^2/codegenv2",
    "@bufbuild/protobuf/wkt": "npm:@bufbuild/protobuf@^2/wkt",
    "@jsquash/webp/decode": "npm:@jsquash/webp@1/decode.js",
    "@jsquash/webp/encode": "npm:@jsquash/webp@1/encode.js",
    "@nats-io/jetstream": "jsr:@nats-io/jetstream@3",
    "@nats-io/transport-deno": "jsr:@nats-io/transport-deno@3",
    "@opensearch-project/opensearch": "npm:@opensearch-project/opensearch@2",
    "@react-email/components": "npm:@react-email/components@0",
    "@react-email/render": "npm:@react-email/render@1",
    "@scribe/alchemy": "./alchemy/mod.ts",
    "@scribe/audience/": "./pkg/packages/audience/",
    "@scribe/auth/": "./pkg/packages/auth/",
    "@scribe/builder": "./pkg/builder/mod.ts",
    "@scribe/builder/tools": "./pkg/builder/tools.ts",
    "@scribe/core/": "./core/",
    "@scribe/dynamic_links/": "./pkg/packages/dynamic_links/",
    "@scribe/foundation/": "./pkg/packages/foundation/",
    "@scribe/host/": "./",
    "@scribe/protocol/": "../protocol/",
    "@scribe/realtime/": "./pkg/packages/realtime/",
    "@scribe/remote_configs/": "./pkg/packages/remote_configs/",
    "@scribe/sdk": "../sdk/js/mod.ts",
    "@scribe/sdk/": "../sdk/js/",
    "@scribe/search/": "./pkg/packages/search/",
    "@scribe/storage/": "./pkg/packages/storage/",
    "@std/assert": "jsr:@std/assert@1",
    "@std/media-types": "jsr:@std/media-types@1",
    "@std/path": "jsr:@std/path@1",
    "@std/testing/mock": "jsr:@std/testing@1/mock",
    "@std/testing/time": "jsr:@std/testing@1/time",
    "@std/yaml": "jsr:@std/yaml@1",
    "@supabase/postgrest-js": "npm:@supabase/postgrest-js@1",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2",
    "bcryptjs": "npm:bcryptjs@2",
    "blurhash": "npm:blurhash@2",
    "croner": "npm:croner@8",
    "fast-png": "npm:fast-png@6",
    "hono": "jsr:@hono/hono@4",
    "ioredis": "npm:ioredis@5",
    "jose": "jsr:@panva/jose@6",
    "jpeg-js": "npm:jpeg-js@0.4",
    "libphonenumber-js": "npm:libphonenumber-js@1",
    "lucide-react": "npm:lucide-react@1",
    "lucide-react/bundle": "npm:/lucide-react@1/dist/cjs/lucide-react.js",
    "nodemailer": "npm:nodemailer@6",
    "react": "npm:react@19",
    "react-dom/server": "npm:react-dom@19/server",
    "react/jsx-runtime": "npm:react@19/jsx-runtime"
  }
}
