{
  "workspace": [
    "./core",
    "./dependencies",
    "./packages/foundation",
    "./packages/realtime",
    "./packages/search",
    "./packages/storage"
  ],
  "tasks": {
    "check": "deno check **/*.ts",
    "test": "deno test --allow-env --allow-sys --allow-read --env-file=tests/.env.test",
    "test:net": "deno test --allow-env --allow-sys --allow-read --allow-net --env-file=tests/.env.test",
    "e2e:render": "deno run --allow-read --allow-write packages/foundation/e2e_tests/render.ts",
    "e2e:compose": "docker compose --project-directory packages/foundation/e2e_tests --env-file packages/foundation/e2e_tests/e2e.env -f packages/foundation/e2e_tests/.generated/valkery.yaml -f packages/foundation/e2e_tests/.generated/queue.yaml -f packages/foundation/e2e_tests/.generated/database.yaml -f packages/foundation/e2e_tests/compose.override.yaml",
    "e2e:up": "deno task e2e:render && deno task e2e:compose up -d --build --wait",
    "e2e:down": "deno task e2e:compose down -v",
    "e2e:reset": "deno task e2e:compose down -v && rm -rf packages/foundation/e2e_tests/.postgres",
    "test:e2e": "deno test --allow-env --allow-sys --allow-read --allow-net --env-file=tests/.env.test packages/foundation/e2e_tests/valkery.e2e.ts packages/foundation/e2e_tests/database.e2e.ts packages/foundation/e2e_tests/queue.e2e.ts packages/foundation/e2e_tests/cron.e2e.ts packages/foundation/e2e_tests/hook.e2e.ts packages/foundation/e2e_tests/http.e2e.ts packages/foundation/e2e_tests/isolate.e2e.ts packages/foundation/e2e_tests/rate_limit.e2e.ts",
    "realtime:e2e:render": "deno run --allow-read --allow-write packages/realtime/e2e_tests/render.ts",
    "realtime:e2e:compose": "docker compose --profile realtime --project-directory packages/realtime/e2e_tests --env-file packages/realtime/e2e_tests/e2e.env -f packages/realtime/e2e_tests/.generated/database.yaml -f packages/realtime/e2e_tests/.generated/realtime.yaml -f packages/realtime/e2e_tests/compose.override.yaml",
    "realtime:e2e:up": "deno task realtime:e2e:render && deno task realtime:e2e:compose up -d --build --wait",
    "realtime:e2e:down": "deno task realtime:e2e:compose down -v",
    "realtime:e2e:reset": "deno task realtime:e2e:compose down -v && rm -rf packages/realtime/e2e_tests/.postgres",
    "storage:e2e:render": "deno run --allow-read --allow-write packages/storage/e2e_tests/render.ts",
    "storage:e2e:compose": "docker compose --project-directory packages/storage/e2e_tests --env-file packages/storage/e2e_tests/e2e.env -f packages/storage/e2e_tests/.generated/database.yaml -f packages/storage/e2e_tests/.generated/storage.yaml -f packages/storage/e2e_tests/compose.override.yaml",
    "storage:e2e:up": "deno task storage:e2e:render && deno task storage:e2e:compose up -d --build --wait",
    "storage:e2e:down": "deno task storage:e2e:compose down -v",
    "storage:e2e:reset": "deno task storage:e2e:compose down -v && rm -rf packages/storage/e2e_tests/.postgres",
    "test:e2e:storage": "deno test --allow-env --allow-sys --allow-read --allow-net --env-file=tests/.env.test packages/storage/e2e_tests/objects.e2e.ts packages/storage/e2e_tests/visibility.e2e.ts",
    "test:e2e:realtime": "deno test --allow-env --allow-sys --allow-read --allow-net --env-file=tests/.env.test packages/realtime/e2e_tests/listening.e2e.ts packages/realtime/e2e_tests/payload.e2e.ts",
    "search:e2e:render": "deno run --allow-read --allow-write packages/search/e2e_tests/render.ts",
    "search:e2e:compose": "docker compose --profile search --project-directory packages/search/e2e_tests --env-file packages/search/e2e_tests/e2e.env -f packages/search/e2e_tests/.generated/valkery.yaml -f packages/search/e2e_tests/.generated/database.yaml -f packages/search/e2e_tests/.generated/search.yaml -f packages/search/e2e_tests/.generated/search_overlay.yaml -f packages/search/e2e_tests/compose.override.yaml",
    "search:e2e:up": "deno task search:e2e:render && deno task search:e2e:compose up -d --build --wait",
    "search:e2e:down": "deno task search:e2e:compose down -v",
    "search:e2e:reset": "deno task search:e2e:compose down -v && rm -rf packages/search/e2e_tests/.postgres",
    "test:e2e:search": "deno test --allow-env --allow-sys --allow-read --allow-net --env-file=tests/.env.test packages/search/e2e_tests/indexing.e2e.ts packages/search/e2e_tests/backlog.e2e.ts",
    "preview:hosting": "deno run --config deno.json --allow-net --allow-env --allow-read --env-file=tests/.env.test --watch api/internal/hosting/_preview.ts",
    "docs:install": "cd api/public/docs && npm install",
    "docs": "cd api/public/docs && npm run dev"
  },
  "fmt": {
    "lineWidth": 120
  },
  "lint": {
    "plugins": [
      "./core/.lint/private-module-scope.ts",
      "./core/.lint/layers.ts",
      "./core/.lint/project-boundary.ts"
    ],
    "rules": {
      "include": [
        "private-module-scope/private-module-scope",
        "layers/layers",
        "project-boundary/project-boundary"
      ]
    }
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "imports": {
    "@scribe/core/": "./core/",
    "@scribe/host/": "./",
    "@scribe/foundation/": "./packages/foundation/",
    "@scribe/realtime/": "./packages/realtime/",
    "@scribe/search/": "./packages/search/",
    "@scribe/storage/": "./packages/storage/",
    "@scribe/protocol/": "../protocol/",
    "@scribe/sdk": "../sdk/js/mod.ts",
    "@scribe/sdk/": "../sdk/js/",
    "@bufbuild/protobuf": "npm:@bufbuild/protobuf@^2",
    "@bufbuild/protobuf/codegenv2": "npm:@bufbuild/protobuf@^2/codegenv2",
    "@bufbuild/protobuf/wkt": "npm:@bufbuild/protobuf@^2/wkt",
    "@std/assert": "jsr:@std/assert@1",
    "@std/media-types": "jsr:@std/media-types@1",
    "@std/testing/mock": "jsr:@std/testing@1/mock",
    "@std/testing/time": "jsr:@std/testing@1/time",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2",
    "@supabase/postgrest-js": "npm:@supabase/postgrest-js@1",
    "@opensearch-project/opensearch": "npm:@opensearch-project/opensearch@2",
    "nodemailer": "npm:nodemailer@6",
    "bcryptjs": "npm:bcryptjs@2",
    "libphonenumber-js": "npm:libphonenumber-js@1",
    "jose": "jsr:@panva/jose@6",
    "blurhash": "npm:blurhash@2",
    "fast-png": "npm:fast-png@6",
    "jpeg-js": "npm:jpeg-js@0.4",
    "@jsquash/webp/decode": "npm:@jsquash/webp@1/decode.js",
    "@jsquash/webp/encode": "npm:@jsquash/webp@1/encode.js",
    "hono": "jsr:@hono/hono@4",
    "ioredis": "npm:ioredis@5",
    "@nats-io/transport-deno": "jsr:@nats-io/transport-deno@3",
    "@nats-io/jetstream": "jsr:@nats-io/jetstream@3",
    "croner": "npm:croner@8",
    "react": "npm:react@19",
    "react/jsx-runtime": "npm:react@19/jsx-runtime",
    "react-dom/server": "npm:react-dom@19/server",
    "@react-email/render": "npm:@react-email/render@1",
    "@react-email/components": "npm:@react-email/components@0",
    "lucide-react": "npm:lucide-react@1",
    "lucide-react/bundle": "npm:/lucide-react@1/dist/cjs/lucide-react.js"
  }
}
